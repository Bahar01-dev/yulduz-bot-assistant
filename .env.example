# ШАБЛОН переменных окружения. Скопируй в .env и заполни своими значениями.
# Реальный .env в git НЕ коммитится (см. .gitignore).

# Токен Telegram-бота. Получить у @BotFather (/newbot или /token). ОБЯЗАТЕЛЬНО.
TELEGRAM_BOT_TOKEN=

# API-ключ для генерации (Claude). Сюда кладём ключ выбранного провайдера:
#   - прямой Anthropic: ключ с console.anthropic.com (sk-ant-...), LLM_BASE_URL пусто;
#   - через OpenRouter:  ключ с openrouter.ai/keys (sk-or-...), задать LLM_BASE_URL ниже.
ANTHROPIC_API_KEY=

# LLM-шлюз. Пусто → прямой Anthropic API. Для OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=

# Модель LLM. Пусто → дефолт (Anthropic: claude-opus-4-8; OpenRouter: anthropic/claude-opus-4).
# Слаги моделей OpenRouter — на openrouter.ai/models.
LLM_MODEL=

# API-ключ Groq для голосового ввода (Whisper STT). ОПЦИОНАЛЬНО.
# Бесплатно на console.groq.com. Если пусто — голосовой ввод выключен.
GROQ_API_KEY=

# API-ключ Tavily для анализа трендов/конкурентов (V2). ОПЦИОНАЛЬНО.
# Бесплатный тариф на app.tavily.com. Если пусто — раздел «Тренды» выключен.
TAVILY_API_KEY=

# Утренний трендовый бриф по расписанию (V2.1). Время «HH:MM» и IANA-пояс.
# Дефолты: 09:00 в Asia/Almaty (UTC+5). Планировщик стартует только при заданном
# TAVILY_API_KEY. Смена = одна переменная (после рестарта).
TREND_DIGEST_TIME=09:00
TREND_TZ=Asia/Almaty

# Твой Telegram user ID — бот работает только для него. ОБЯЗАТЕЛЬНО.
# Узнать у @userinfobot. Целое число.
OWNER_TELEGRAM_ID=

# Путь к файлу SQLite-базы.
# Локально: data/bot.db. На Railway: /app/data/bot.db (Persistent Volume).
DATABASE_PATH=data/bot.db
